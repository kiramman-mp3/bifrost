{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIFRÖST",
  "version": "0.5.2",
  "identifier": "org.bifrost.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BIFRÖST",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
